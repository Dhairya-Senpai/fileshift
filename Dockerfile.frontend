# Multi-stage build: compile React in node, serve static assets via nginx.
# Final image is ~25 MB and contains zero Node runtime — much smaller and
# more secure than serving Vite's dev server in production.

# ─── Stage 1: build ────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src ./src

RUN npm run build
# Output: /app/dist (static HTML/CSS/JS)

# ─── Stage 2: serve ────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Custom nginx config:
#   - proxies /api → backend service over the docker network
#   - SPA fallback (all unknown routes → index.html)
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

# nginx alpine already runs workers as `nginx` user; master must stay root
# to bind port 80. This is the standard nginx container pattern.

EXPOSE 80

# nginx handles SIGTERM correctly without tini.
CMD ["nginx", "-g", "daemon off;"]
