# ─── Secrets ──────────────────────────────────────────────────────────────
# .env files contain DOWNLOAD_TOKEN_SECRET and other sensitive values.
# Never commit any of them. Only .env.example is tracked.
.env
.env.*
!.env.example
!**/.env.example

# ─── Node / npm ───────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Lockfile policy: package-lock.json IS tracked (it pins deps for reproducible
# builds — that's the whole point). If you switch to pnpm/yarn, track their
# lockfiles instead and ignore the others.
# yarn.lock
# pnpm-lock.yaml

# ─── Build output ─────────────────────────────────────────────────────────
dist/
build/
.vite/
.cache/

# ─── Runtime / storage ────────────────────────────────────────────────────
# User-uploaded files and conversion outputs — never commit these.
# The directories themselves stay tracked via .gitkeep.
backend/storage/uploads/*
backend/storage/outputs/*
backend/storage/work/*
!backend/storage/uploads/.gitkeep
!backend/storage/outputs/.gitkeep
!backend/storage/work/.gitkeep

# ─── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Editor / IDE ─────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── Test artifacts (if you add tests later) ──────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Docker scratch (volumes are managed by docker, not git) ──────────────
# These don't normally show up in your project dir, but just in case:
.docker/

# ─── Misc ─────────────────────────────────────────────────────────────────
*.tgz
*.zip
*.tar.gz
.pid
.lock-wscript